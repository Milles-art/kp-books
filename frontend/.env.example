# Laravel server (used by the dev proxy). Leave VITE_API_URL empty in production if the API is on the same domain.
VITE_API_URL=http://localhost:8000
# localStorage key where the KP Wear login stores the Sanctum token
VITE_TOKEN_KEY=token
# Optional: a Sanctum token for local testing without the login screen
VITE_DEV_TOKEN=
# Where to send readers who need to log in
VITE_LOGIN_URL=/login
# Demo only: confirm payments through the simulate-confirm endpoint
VITE_SIMULATE_PAYMENTS=true
# Link back to the KP Wear shop (header and footer)
VITE_WEAR_URL=https://kipanya.bizismart.com
